PACKAGE_NAME=gdal
BASE_DIR="${DEV_BASE_DIR}/gdal-3.9.2"

SOURCE_RETRIEVAL_METHOD=wget
SOURCE_FORMAT=tgz
SOURCE_URL=http://download.osgeo.org/gdal/3.9.2/gdal-3.9.2.tar.gz

SOURCE_DIR="${BASE_DIR}"
BUILD_DIR="${BASE_DIR}/build-${ARCH}"
INSTALL_DIR="${BASE_DIR}/install-${ARCH}"

PREBUILD_METHOD=cmake

CMAKE_PARAMS+=( -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR}" )
CMAKE_PARAMS+=( -DBUILD_SHARED_LIBS=ON )
CMAKE_PARAMS+=( -DBUILD_TESTING=OFF )
CMAKE_PARAMS+=( -DPROJ_INCLUDE_DIR="${proj_INSTALL_DIR}/include" )
CMAKE_PARAMS+=( -DPROJ_LIBRARY="${proj_INSTALL_DIR}/lib/libproj.so" )
CMAKE_PARAMS+=( -DGEOS_INCLUDE_DIR="${geos_INSTALL_DIR}/include" )
CMAKE_PARAMS+=( -DGEOS_CONFIG="${geos_INSTALL_DIR}/bin/geos-config" )
if [[ -d "${filegdbsdk_INSTALL_DIR}" ]]; then
  CMAKE_PARAMS+=( -DFileGDB_INCLUDE_DIR="${filegdbsdk_INSTALL_DIR}/include" )
  CMAKE_PARAMS+=( -DFileGDB_LIBRARY="${filegdbsdk_INSTALL_DIR}/lib/libFileGDBAPI.so" )
fi
if [[ -d "${sqlite_INSTALL_DIR}" ]]; then
  CMAKE_PARAMS+=( -DCMAKE_PREFIX_PATH="${sqlite_INSTALL_DIR}" )
fi
if [[ -d "${XERCES_INSTALL_DIR}" ]]; then
  CMAKE_PARAMS+=( -DXercesC_INCLUDE_DIR="${XERCES_INSTALL_DIR}/include" )
  CMAKE_PARAMS+=( -DXercesC_LIBRARY="${XERCES_INSTALL_DIR}/lib/libxerces-c.so" )
fi
CMAKE_PARAMS+=( -DCMAKE_INSTALL_RPATH="${proj_INSTALL_DIR}/lib:${filegdbsdk_INSTALL_DIR}/lib:${XERCES_INSTALL_DIR}/lib" )

CMAKE_PARAMS+=( -DBUILD_CSHARP_BINDINGS=OFF )
CMAKE_PARAMS+=( -DBUILD_JAVA_BINDINGS=OFF )
CMAKE_PARAMS+=( -DBUILD_PYTHON_BINDINGS=OFF )
#CMAKE_PARAMS+=( -DGDAL_PYTHON_BINDINGS_WITHOUT_NUMPY=OFF )

case $PLATFORM in
  Windows)
    MSVC_CONFIG="${BUILD_TYPE}"
    if [ ${ARCH} = "32-bit" ]; then
      MSVC_PLATFORM=Win32
    else
      MSVC_PLATFORM=x64
    fi
    MSVC_SOLUTION=( "GDAL.sln" )

    CMAKE_PARAMS+=( -DCMAKE_CONFIGURATION_TYPES="${BUILD_TYPE}" )

    POST_BUILD_METHOD+=( "cd ${SOURCE_DIR}" )
    POST_BUILD_METHOD+=( "cp --parents -r swig/include ${INSTALL_DIR}" )
    ;;
  Darwin)
    CMAKE_PARAMS+=( -DCMAKE_CXX_FLAGS="-std=c++14 -stdlib=libc++" )
    CMAKE_PARAMS+=( -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" )

    POST_BUILD_METHOD+=( "cd ${SOURCE_DIR}" )
    POST_BUILD_METHOD+=( "ditto swig/include ${INSTALL_DIR}/swig/include" )
    ;;
  Linux)
    CMAKE_PARAMS+=( -DCMAKE_CXX_FLAGS="-std=c++14 -Dlinux" )
    CMAKE_PARAMS+=( -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" )

    POST_BUILD_METHOD+=( "cd ${SOURCE_DIR}" )
    POST_BUILD_METHOD+=( "cp --parents -r swig/include ${INSTALL_DIR}" )
    POST_BUILD_METHOD+=( "cp swig/python/gdal-utils/scripts/*.py ${INSTALL_DIR}/bin" )
    ;;
esac
